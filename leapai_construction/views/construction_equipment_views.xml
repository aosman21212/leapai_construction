<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== EQUIPMENT ==================== -->

    <record id="view_construction_equipment_list" model="ir.ui.view">
        <field name="name">construction.equipment.list</field>
        <field name="model">construction.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment" decoration-danger="status == 'out_of_service'" decoration-warning="status == 'under_maintenance'">
                <field name="ref"/>
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="manufacturer"/>
                <field name="model_no"/>
                <field name="serial_no"/>
                <field name="year"/>
                <field name="project_id"/>
                <field name="last_maintenance_date"/>
                <field name="next_maintenance_date"/>
                <field name="daily_rate" optional="show"/>
                <field name="currency_id" optional="hide"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-info="status == 'deployed'" decoration-warning="status == 'under_maintenance'" decoration-danger="status == 'out_of_service'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_equipment_form" model="ir.ui.view">
        <field name="name">construction.equipment.form</field>
        <field name="model">construction.equipment</field>
        <field name="arch" type="xml">
            <form string="Construction Equipment">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,deployed,under_maintenance,out_of_service"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="ref" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Equipment Details">
                            <field name="equipment_type"/>
                            <field name="manufacturer"/>
                            <field name="model_no"/>
                            <field name="serial_no"/>
                            <field name="year"/>
                        </group>
                        <group string="Assignment &amp; Finance">
                            <field name="project_id"/>
                            <field name="daily_rate"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Maintenance">
                            <field name="last_maintenance_date"/>
                            <field name="next_maintenance_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_equipment_search" model="ir.ui.view">
        <field name="name">construction.equipment.search</field>
        <field name="model">construction.equipment</field>
        <field name="arch" type="xml">
            <search string="Search Equipment">
                <field name="name"/>
                <field name="ref"/>
                <field name="serial_no"/>
                <field name="project_id"/>
                <separator/>
                <filter name="available" string="Available" domain="[('status','=','available')]"/>
                <filter name="deployed" string="Deployed" domain="[('status','=','deployed')]"/>
                <filter name="under_maintenance" string="Under Maintenance" domain="[('status','=','under_maintenance')]"/>
                <filter name="out_of_service" string="Out of Service" domain="[('status','=','out_of_service')]"/>
                <separator/>
                <group>
                    <filter name="group_type" string="Equipment Type" context="{'group_by': 'equipment_type'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">construction.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== EQUIPMENT MAINTENANCE ==================== -->

    <record id="view_construction_equipment_maintenance_list" model="ir.ui.view">
        <field name="name">construction.equipment.maintenance.list</field>
        <field name="model">construction.equipment.maintenance</field>
        <field name="arch" type="xml">
            <list string="Equipment Maintenance">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="project_id"/>
                <field name="maintenance_type"/>
                <field name="date_reported"/>
                <field name="date_completed"/>
                <field name="assigned_to"/>
                <field name="cost"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_equipment_maintenance_form" model="ir.ui.view">
        <field name="name">construction.equipment.maintenance.form</field>
        <field name="model">construction.equipment.maintenance</field>
        <field name="arch" type="xml">
            <form string="Equipment Maintenance">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Maintenance Details">
                            <field name="equipment_id"/>
                            <field name="project_id"/>
                            <field name="maintenance_type"/>
                            <field name="reported_by"/>
                            <field name="assigned_to"/>
                        </group>
                        <group string="Dates &amp; Cost">
                            <field name="date_reported"/>
                            <field name="date_completed"/>
                            <field name="cost"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Resolution">
                            <field name="resolution"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_equipment_maintenance_search" model="ir.ui.view">
        <field name="name">construction.equipment.maintenance.search</field>
        <field name="model">construction.equipment.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="project_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <separator/>
                <filter name="emergency" string="Emergency" domain="[('maintenance_type','=','emergency')]"/>
                <separator/>
                <group>
                    <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_type" string="Maintenance Type" context="{'group_by': 'maintenance_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_equipment_maintenance" model="ir.actions.act_window">
        <field name="name">Equipment Maintenance</field>
        <field name="res_model">construction.equipment.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
