<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== PROJECT TYPE ==================== -->

    <record id="view_construction_project_type_list" model="ir.ui.view">
        <field name="name">construction.project.type.list</field>
        <field name="model">construction.project.type</field>
        <field name="arch" type="xml">
            <list string="Project Types">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_construction_project_type_form" model="ir.ui.view">
        <field name="name">construction.project.type.form</field>
        <field name="model">construction.project.type</field>
        <field name="arch" type="xml">
            <form string="Project Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_project_type" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">construction.project.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== CONSTRUCTION PROJECT ==================== -->

    <record id="view_construction_project_kanban" model="ir.ui.view">
        <field name="name">construction.project.kanban</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="ref"/>
                <field name="client_id"/>
                <field name="state"/>
                <field name="project_manager_id"/>
                <field name="contract_value"/>
                <field name="currency_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="ref"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user" title="Client"/> <field name="client_id"/></div>
                                <div><i class="fa fa-calendar" title="Dates"/> <field name="start_date"/> - <field name="end_date"/></div>
                                <div><i class="fa fa-money" title="Contract Value"/> <field name="contract_value"/> <field name="currency_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="project_manager_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_construction_project_list" model="ir.ui.view">
        <field name="name">construction.project.list</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <list string="Projects" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'" decoration-warning="state == 'on_hold'" decoration-danger="state == 'cancelled'">
                <field name="ref"/>
                <field name="name"/>
                <field name="project_type_id"/>
                <field name="client_id"/>
                <field name="project_manager_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="contract_value" optional="show"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'" decoration-warning="state == 'on_hold'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_project_form" model="ir.ui.view">
        <field name="name">construction.project.form</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <form string="Construction Project">
                <header>
                    <button name="action_set_in_progress" string="Start" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_set_on_hold" string="Put On Hold" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_set_in_progress" string="Resume" type="object"
                            invisible="state != 'on_hold'"/>
                    <button name="action_set_completed" string="Mark Completed" type="object"
                            invisible="state not in ('in_progress', 'on_hold')" class="btn-primary"/>
                    <button name="action_set_cancelled" string="Cancel" type="object"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rfis" type="object"
                                class="oe_stat_button" icon="fa-question-circle">
                            <field name="rfi_count" string="RFIs" widget="statinfo"/>
                        </button>
                        <button name="action_view_ncrs" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="ncr_count" string="NCRs" widget="statinfo"/>
                        </button>
                        <button name="action_view_permits" type="object"
                                class="oe_stat_button" icon="fa-shield">
                            <field name="permit_count" string="Permits" widget="statinfo"/>
                        </button>
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file">
                            <field name="document_count" string="Documents" widget="statinfo"/>
                        </button>
                        <button name="action_view_budgets" type="object"
                                class="oe_stat_button" icon="fa-usd">
                            <field name="budget_count" string="Budgets" widget="statinfo"/>
                        </button>
                        <button name="action_view_attendance" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="attendance_count" string="Attendance" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Project Name"/></h1>
                        <h2><field name="ref" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Project Details">
                            <field name="project_type_id"/>
                            <field name="client_id"/>
                            <field name="site_address"/>
                        </group>
                        <group string="Finance">
                            <field name="contract_value"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Planned Dates">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Actual Dates">
                            <field name="actual_start"/>
                            <field name="actual_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="Team">
                            <field name="project_manager_id"/>
                            <field name="site_engineer_id"/>
                            <field name="team_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_project_search" model="ir.ui.view">
        <field name="name">construction.project.search</field>
        <field name="model">construction.project</field>
        <field name="arch" type="xml">
            <search string="Search Projects">
                <field name="name"/>
                <field name="ref"/>
                <field name="client_id"/>
                <field name="project_manager_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="on_hold" string="On Hold" domain="[('state','=','on_hold')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_manager" string="Project Manager" context="{'group_by': 'project_manager_id'}"/>
                    <filter name="group_type" string="Project Type" context="{'group_by': 'project_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">construction.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first construction project!</p>
        </field>
    </record>

</odoo>
