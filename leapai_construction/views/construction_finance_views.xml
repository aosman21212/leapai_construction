<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== ESTIMATE ==================== -->

    <record id="view_construction_estimate_list" model="ir.ui.view">
        <field name="name">construction.estimate.list</field>
        <field name="model">construction.estimate</field>
        <field name="arch" type="xml">
            <list string="Estimates">
                <field name="name"/>
                <field name="project_id"/>
                <field name="client_id"/>
                <field name="date"/>
                <field name="validity_date"/>
                <field name="prepared_by"/>
                <field name="subtotal"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_estimate_form" model="ir.ui.view">
        <field name="name">construction.estimate.form</field>
        <field name="model">construction.estimate</field>
        <field name="arch" type="xml">
            <form string="Cost Estimate">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Estimate Details">
                            <field name="project_id"/>
                            <field name="client_id"/>
                            <field name="prepared_by"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Dates">
                            <field name="date"/>
                            <field name="validity_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="uom"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_estimate_search" model="ir.ui.view">
        <field name="name">construction.estimate.search</field>
        <field name="model">construction.estimate</field>
        <field name="arch" type="xml">
            <search string="Search Estimates">
                <field name="name"/>
                <field name="project_id"/>
                <field name="client_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="sent" string="Sent" domain="[('state','=','sent')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_estimate" model="ir.actions.act_window">
        <field name="name">Estimates</field>
        <field name="res_model">construction.estimate</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== BUDGET ==================== -->

    <record id="view_construction_budget_list" model="ir.ui.view">
        <field name="name">construction.budget.list</field>
        <field name="model">construction.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets">
                <field name="name"/>
                <field name="project_id"/>
                <field name="budget_type"/>
                <field name="approved_by"/>
                <field name="approved_date"/>
                <field name="total_budgeted"/>
                <field name="total_actual"/>
                <field name="total_variance"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_budget_form" model="ir.ui.view">
        <field name="name">construction.budget.form</field>
        <field name="model">construction.budget</field>
        <field name="arch" type="xml">
            <form string="Project Budget">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Budget Details">
                            <field name="project_id"/>
                            <field name="budget_type"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Approval">
                            <field name="approved_by"/>
                            <field name="approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="category"/>
                                    <field name="description"/>
                                    <field name="uom"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="budgeted_amount" readonly="1"/>
                                    <field name="actual_amount"/>
                                    <field name="variance" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_budgeted"/>
                                <field name="total_actual"/>
                                <field name="total_variance"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_budget_search" model="ir.ui.view">
        <field name="name">construction.budget.search</field>
        <field name="model">construction.budget</field>
        <field name="arch" type="xml">
            <search string="Search Budgets">
                <field name="name"/>
                <field name="project_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <separator/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Budget Type" context="{'group_by': 'budget_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">construction.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== COST SHEET ==================== -->

    <record id="view_construction_cost_sheet_list" model="ir.ui.view">
        <field name="name">construction.cost.sheet.list</field>
        <field name="model">construction.cost.sheet</field>
        <field name="arch" type="xml">
            <list string="Cost Sheets">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="prepared_by"/>
                <field name="grand_total"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_construction_cost_sheet_form" model="ir.ui.view">
        <field name="name">construction.cost.sheet.form</field>
        <field name="model">construction.cost.sheet</field>
        <field name="arch" type="xml">
            <form string="Cost Sheet">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Cost Sheet Details">
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="prepared_by"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Totals">
                            <field name="total_labour" readonly="1"/>
                            <field name="total_material" readonly="1"/>
                            <field name="total_equipment" readonly="1"/>
                            <field name="total_subcontract" readonly="1"/>
                            <field name="total_overhead" readonly="1"/>
                            <field name="grand_total" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="cost_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="unit_cost"/>
                                    <field name="amount" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_cost_sheet_search" model="ir.ui.view">
        <field name="name">construction.cost.sheet.search</field>
        <field name="model">construction.cost.sheet</field>
        <field name="arch" type="xml">
            <search string="Search Cost Sheets">
                <field name="name"/>
                <field name="project_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <separator/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_cost_sheet" model="ir.actions.act_window">
        <field name="name">Cost Sheets</field>
        <field name="res_model">construction.cost.sheet</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== CHANGE ORDER ==================== -->

    <record id="view_construction_change_order_list" model="ir.ui.view">
        <field name="name">construction.change.order.list</field>
        <field name="model">construction.change.order</field>
        <field name="arch" type="xml">
            <list string="Change Orders">
                <field name="name"/>
                <field name="project_id"/>
                <field name="subject"/>
                <field name="submitted_by"/>
                <field name="date_submitted"/>
                <field name="cost_impact"/>
                <field name="time_impact_days"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_change_order_form" model="ir.ui.view">
        <field name="name">construction.change.order.form</field>
        <field name="model">construction.change.order</field>
        <field name="arch" type="xml">
            <form string="Change Order">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Change Order Details">
                            <field name="project_id"/>
                            <field name="subject"/>
                            <field name="submitted_by"/>
                            <field name="date_submitted"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Impact">
                            <field name="cost_impact"/>
                            <field name="time_impact_days"/>
                            <field name="approved_by"/>
                            <field name="date_approved"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason">
                            <field name="reason"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_change_order_search" model="ir.ui.view">
        <field name="name">construction.change.order.search</field>
        <field name="model">construction.change.order</field>
        <field name="arch" type="xml">
            <search string="Search Change Orders">
                <field name="name"/>
                <field name="subject"/>
                <field name="project_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_change_order" model="ir.actions.act_window">
        <field name="name">Change Orders</field>
        <field name="res_model">construction.change.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== IPC ==================== -->

    <record id="view_construction_ipc_list" model="ir.ui.view">
        <field name="name">construction.ipc.list</field>
        <field name="model">construction.ipc</field>
        <field name="arch" type="xml">
            <list string="IPCs">
                <field name="name"/>
                <field name="project_id"/>
                <field name="client_id"/>
                <field name="ipc_number"/>
                <field name="date"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="total_claimed"/>
                <field name="net_certified"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_ipc_form" model="ir.ui.view">
        <field name="name">construction.ipc.form</field>
        <field name="model">construction.ipc</field>
        <field name="arch" type="xml">
            <form string="Interim Payment Certificate">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,certified,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="IPC Details">
                            <field name="project_id"/>
                            <field name="client_id"/>
                            <field name="ipc_number"/>
                            <field name="date"/>
                            <field name="prepared_by"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Period">
                            <field name="period_from"/>
                            <field name="period_to"/>
                        </group>
                    </group>
                    <group string="Financial Summary">
                        <group>
                            <field name="contract_value"/>
                            <field name="total_claimed"/>
                        </group>
                        <group>
                            <field name="retention_percentage"/>
                            <field name="retention_amount" readonly="1"/>
                            <field name="net_certified" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_ipc_search" model="ir.ui.view">
        <field name="name">construction.ipc.search</field>
        <field name="model">construction.ipc</field>
        <field name="arch" type="xml">
            <search string="Search IPCs">
                <field name="name"/>
                <field name="project_id"/>
                <field name="client_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="certified" string="Certified" domain="[('state','=','certified')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <separator/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_ipc" model="ir.actions.act_window">
        <field name="name">IPCs</field>
        <field name="res_model">construction.ipc</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
