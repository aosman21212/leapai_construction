<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== DOCUMENT ==================== -->

    <record id="view_construction_document_list" model="ir.ui.view">
        <field name="name">construction.document.list</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <list string="Documents">
                <field name="name"/>
                <field name="project_id"/>
                <field name="document_type"/>
                <field name="revision"/>
                <field name="prepared_by"/>
                <field name="date_prepared"/>
                <field name="date_expires"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'under_review'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_document_form" model="ir.ui.view">
        <field name="name">construction.document.form</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <form string="Construction Document">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_review,approved,superseded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Document Details">
                            <field name="project_id"/>
                            <field name="document_type"/>
                            <field name="revision"/>
                        </group>
                        <group string="Review &amp; Approval">
                            <field name="prepared_by"/>
                            <field name="reviewed_by"/>
                            <field name="approved_by"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="date_prepared"/>
                            <field name="date_expires"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_document_search" model="ir.ui.view">
        <field name="name">construction.document.search</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name"/>
                <field name="project_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="under_review" string="Under Review" domain="[('state','=','under_review')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="superseded" string="Superseded" domain="[('state','=','superseded')]"/>
                <separator/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'document_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_document" model="ir.actions.act_window">
        <field name="name">Document Register</field>
        <field name="res_model">construction.document</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
